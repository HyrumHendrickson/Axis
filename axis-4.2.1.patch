+    def wait_for(self, path, timeout=10):
+        deadline = time.time() + timeout
+        while time.time() < deadline and not path.exists():
+            time.sleep(0.05)
+        self.assertTrue(path.exists(), f"{path} never appeared")
+        time.sleep(0.1)
+        return path.read_text()
